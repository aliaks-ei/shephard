MCP_SUPABASE_URL=https://example.supabase.co
MCP_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# The full public MCP endpoint, including /mcp.
MCP_RESOURCE_URL=https://mcp.example.com/mcp
MCP_TOKEN_AUDIENCE=shephard-mcp
# Optional locally. Railway's injected PORT is used when MCP_PORT is absent.
MCP_PORT=8787
# Comma-separated browser origins. Server-to-server ChatGPT and Claude requests send no Origin header.
MCP_ALLOWED_ORIGINS=https://shephard.app,https://www.shephard.app
# Defaults to MCP_RESOURCE_URL's host. Add localhost only for local development.
MCP_ALLOWED_HOSTS=mcp.example.com
